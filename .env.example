# ─── MY SEU — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Google Maps Embed API key
# Get one at: console.cloud.google.com → Maps Embed API → Credentials
MAPS_EMBED_API_KEY=YOUR_MAPS_EMBED_API_KEY

# Cloudflare Worker URL for the UMS proxy (no trailing slash)
# Deploy the worker from the embed_plan guide, then paste its URL here
UMS_PROXY_URL=https://ums-proxy.YOUR_SUBDOMAIN.workers.dev

# Google OAuth 2.0 Client ID for Classroom API (web client)
# Get one at: console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
CLASSROOM_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

